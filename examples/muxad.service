[Unit]
Description=muxa agent observability daemon
Documentation=https://github.com/Open330/muxa
After=default.target

[Service]
Type=simple
ExecStart=%h/.cargo/bin/muxad
Restart=on-failure
RestartSec=2

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%t

[Install]
WantedBy=default.target
