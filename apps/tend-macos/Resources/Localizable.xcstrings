          }
        }
      }
    },
    "tendd notifies when an agent starts waiting for a person, hits an error, or stops mid-turn. Repeats for the same agent are suppressed for 30 seconds." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tendd는 에이전트가 사람을 기다리기 시작하거나, 오류가 나거나, 턴 도중 멈출 때 알립니다. 같은 에이전트의 반복 알림은 30초 동안 억제됩니다."
          }
        }
      }
    },
    "tendd rejected the judgment" : {
      "extractionState" : "stale",
      "localizations" : {
        "ko" : {
