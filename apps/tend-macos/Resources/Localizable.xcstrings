    "Tend Workspace" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tend 워크스페이스"
          }
        }
      }
    },
    "Tend checks again whenever you come back to this window. Nothing here is required to look around." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 창으로 돌아올 때마다 Tend가 다시 확인합니다. 둘러보는 데 필요한 항목은 없습니다."
          }
        }
      }
    },
    "Tend could not read the environment for %@. Check it with `aas export %@` in a terminal." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tend could not read the environment for %1$@. Check it with `aas export %2$@` in a terminal."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@의 환경을 읽지 못했습니다. 터미널에서 `aas export %2$@`로 확인해 보세요."
          }
        }
      }
    },
    "Tend is not connected to its daemon." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
