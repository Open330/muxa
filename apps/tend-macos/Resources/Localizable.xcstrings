    "tend swap exited with %d" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tend swap이 %d 코드로 종료되었습니다"
          }
        }
      }
    },
    "Tend types continue two minutes after the limit resets (or after 20 minutes when no reset time is known)." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "한도가 초기화되고 2분 뒤에 continue를 입력합니다(초기화 시각을 모르면 20분 뒤)."
          }
