          }
        }
      }
    },
    "Tend reads AIR workflow-skill documents; this one is %@ · %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tend reads AIR workflow-skill documents; this one is %1$@ · %2$@."
