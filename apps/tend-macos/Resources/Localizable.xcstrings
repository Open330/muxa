            "state" : "translated",
            "value" : "tendd 업그레이드 필요"
          }
        }
      }
    },
    "tendd watches your agents and acts on rules you write — resuming a capped session, for one." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "tendd가 에이전트를 지켜보다가 직접 작성한 규칙에 따라 움직입니다. 한도에 걸린 세션을 다시 이어 가는 것이 그 예입니다."
          }
        }
      }
