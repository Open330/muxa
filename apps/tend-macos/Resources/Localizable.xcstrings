    },
    "A small random delay is added so several agents do not resume at once." : {
      "extractionState" : "stale",
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러 에이전트가 동시에 재개하지 않도록 약간의 무작위 지연이 추가됩니다."
          }
        }
      }
    },
    "A terminal owned by tendd on this Mac, like a Tend shell." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tend 셸처럼 이 Mac의 tendd가 소유하는 터미널입니다."
          }
        }
      }
    },
    "A waiting agent is nudged at its top-level prompt, never mid-turn." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대기 중인 에이전트를 최상위 프롬프트에서만 깨우고, 턴 도중에는 건드리지 않습니다."
          }
        }
      }
    },
    "Asked by %@" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
