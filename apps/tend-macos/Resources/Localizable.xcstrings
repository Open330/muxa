            "value" : "삭제됨"
          }
        }
      }
    },
    "Deletes the folder with git. Its local files and worktree-specific git data cannot be restored; only its last commit stays in the repository, under refs/tend/set-aside/." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
