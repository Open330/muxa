        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@이(가) %2$lld초 안에 응답하지 않았습니다"
          }
        }
      }
    },
    "%@ has a different definition; Sync overwrites it" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@의 정의가 다릅니다. 동기화하면 덮어씁니다"
          }
        }
      }
    },
    "%@ is already the active %@ account." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is already the active %2$@ account."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@은(는) 이미 활성 %2$@ 계정입니다."
          }
        }
      }
    },
    "%@ is deleted from muxa's config. Past conversations stay in your history." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) muxa 설정에서 삭제됩니다. 지난 대화는 기록에 그대로 남습니다."
          }
        }
      }
    },
    "%@ is no longer present on %@. The conversation is still available, but its live agent cannot be opened." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@이(가) %2$@에 더 이상 없습니다. 대화는 남아 있지만 실행 중인 에이전트는 열 수 없습니다."
          }
        }
      }
    },
    "%@ is not currently available." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 현재 사용할 수 없습니다."
          }
        }
      }
    },
    "%@ is not on your PATH yet" : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 아직 PATH에 없습니다"
