        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muxa는 AIR %@을(를) 읽습니다. 이 파일은 AIR %@입니다."
          }
        }
      }
    },
    "Muxa reads AIR workflow-skill documents; this one is %@ · %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Muxa reads AIR workflow-skill documents; this one is %1$@ · %2$@."
          }
