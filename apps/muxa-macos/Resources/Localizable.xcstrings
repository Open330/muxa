    },
    "Muxa checks these every time this guide opens. Nothing here is required to look around." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 안내를 열 때마다 Muxa가 아래 항목을 확인합니다. 둘러보는 데 필수인 항목은 없습니다."
          }
        }
      }
    },
    "Muxa could not read the environment for %@. Check it with `aas export %@` in a terminal." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Muxa could not read the environment for %1$@. Check it with `aas export %2$@` in a terminal."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@의 환경을 읽지 못했습니다. 터미널에서 `aas export %2$@`로 확인해 보세요."
          }
        }
      }
    },
    "Muxa is not connected to its daemon." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Muxa가 데몬에 연결되어 있지 않습니다."
          }
        }
      }
    },
    "Muxa reads AIR %@; this file is AIR %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Muxa reads AIR %1$@; this file is AIR %2$@."
