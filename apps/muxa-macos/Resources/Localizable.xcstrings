        }
      }
    },
    "%@ is required for this event." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 이벤트에는 %@이(가) 필요합니다."
          }
        }
      }
    },
    "%@ is the default provider, so muxad will fall back to another one. Past conversations stay in your history." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 기본 프로바이더이므로 muxad가 다른 프로바이더로 대체합니다. 지난 대화는 기록에 그대로 남습니다."
          }
        }
      }
    },
    "%@ may not exceed 24 hours." : {
      "localizations" : {
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@은(는) 24시간을 넘길 수 없습니다."
          }
        }
      }
    },
    "%@ must be a duration such as 30s, 5m or 2h." : {
